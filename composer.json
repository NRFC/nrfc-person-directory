{
  "name": "nrfc/nrfc_person_directory",
  "description": "nrfc_person_directory plugin for wordpress",
  "type": "wordpress-plugin",
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "nrfc_person_directory\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}

